# =============================================================================
# NexusNotes — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────────────────────
APP_ENV=development
# Options: development | staging | production
APP_NAME=NexusNotes
APP_VERSION=1.0.0
DEBUG=true

# ──────────────────────────────────────────────────────────────────────────────
# Backend API
# ──────────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ──────────────────────────────────────────────────────────────────────────────
# Database (MySQL)
# ──────────────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_DATABASE=nexusnotes
MYSQL_USER=nexusnotes
MYSQL_PASSWORD=changeme_db_password
MYSQL_HOST=db
MYSQL_PORT=3306

# Full async DSN used by SQLAlchemy
DATABASE_URL=mysql+aiomysql://nexusnotes:changeme_db_password@db:3306/nexusnotes

# ──────────────────────────────────────────────────────────────────────────────
# Authentication (JWT)
# ──────────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=changeme_generate_a_real_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ──────────────────────────────────────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────────
# AWS / S3 Configuration
# ──────────────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=nexusnotes-assets
AWS_S3_PREFIX=

# When deployed to EC2 with IAM role, leave these empty — role provides credentials.
# For local development with MinIO, set these:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3-compatible endpoint (MinIO for local dev, empty for real AWS)
# Local:      http://minio:9000
# AWS:        (leave empty)
S3_ENDPOINT_URL=http://minio:9000

# ──────────────────────────────────────────────────────────────────────────────
# MinIO (local S3 emulation — development only)
# ──────────────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio_password
MINIO_BUCKET=nexusnotes-assets

# ──────────────────────────────────────────────────────────────────────────────
# File Uploads
# ──────────────────────────────────────────────────────────────────────────────
# Maximum upload size in bytes (default: 10 MB)
MAX_UPLOAD_SIZE=10485760
# Allowed MIME types (comma-separated)
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp,image/svg+xml

# ──────────────────────────────────────────────────────────────────────────────
# Frontend
# ──────────────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=NexusNotes
VITE_APP_VERSION=1.0.0

# ──────────────────────────────────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL

# ──────────────────────────────────────────────────────────────────────────────
# Rate Limiting
# ──────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
